# =========================
# Database (PostgreSQL + PostGIS)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=safezone
DB_PASSWORD=safezone_dev_password
DB_NAME=safezone_india
DB_SSL_MODE=disable

# For Neon (production)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/safezone_india?sslmode=require

# =========================
# Redis (Upstash)
# =========================
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# =========================
# JWT Auth
# =========================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# =========================
# API Gateway
# =========================
GATEWAY_PORT=8080
GATEWAY_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =========================
# Service Ports
# =========================
AUTH_SERVICE_PORT=8081
LOCATION_SERVICE_PORT=8082
INCIDENT_SERVICE_PORT=8083
RISK_SERVICE_PORT=8084
ANALYTICS_SERVICE_PORT=8085
ALERT_SERVICE_PORT=8086
SOS_SERVICE_PORT=8087

# =========================
# AI/ML Service
# =========================
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_PORT=8090

# =========================
# Gemini AI (Free Tier)
# =========================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# =========================
# SMS/Call (MSG91 Free Tier)
# =========================
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SFZONE
MSG91_TEMPLATE_SOS=your-sos-template-id

# =========================
# Frontend
# =========================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_AI_URL=http://localhost:8090
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# =========================
# Seeding (cmd/seed)
# =========================
# Password set for admin@safezone.in by `make seed`. Migration 000009 inserts a
# placeholder hash; the seeder replaces it with a bcrypt hash of this value.
# Change this before seeding anything other than local development.
ADMIN_PASSWORD=admin123

# =========================
# Rate Limiting
# =========================
RATE_LIMIT_RPM=60
RATE_LIMIT_SOS_RPM=10

# =========================
# Citizen sign-in
# =========================
# SMS provider for phone OTPs. Leave EMPTY in development: the API then returns
# the code in its response instead of sending it, so the flow is testable.
# Transactional SMS in India requires DLT registration with a pre-approved
# template, so use a provider that supports it (MSG91, Gupshup, Kaleyra).
SMS_PROVIDER=

# Google Sign-In. One OAuth client ID per platform — the same app has a separate
# client on iOS, Android and web, and any of them can appear in an ID token's
# `aud`. Leave empty to disable Google sign-in; the API then reports
# {"enabled": false} and the app hides the button.
# These must match extra.google*ClientId in mobile/app.json.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
